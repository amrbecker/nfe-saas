# Copie este arquivo para `.env` e preencha com valores reais antes de subir o docker compose.
# O `.env` é ignorado pelo git; nunca commitar secrets.

# === Postgres ===
POSTGRES_DB=nfesaas
POSTGRES_USER=nfesaas
# Gere uma senha forte (ex.: openssl rand -base64 24)
POSTGRES_PASSWORD=__TROCAR__

# === JWT ===
# Mínimo 32 caracteres. Gere com: openssl rand -base64 48
# Program.cs faz fail-fast no startup se vazio, curto ou contendo SUA_CHAVE/__TROCAR.
JWT_SECRET=__TROCAR_MIN_32_CHARS__
JWT_ISSUER=NfeSaas
JWT_AUDIENCE=NfeSaas.WebUI

# === Ambiente ===
ASPNETCORE_ENVIRONMENT=Production
WEBUI_BASE_URL=http://localhost:5002

# === Data Protection (cifragem em repouso) ===
# Path interno onde as chaves de cifragem ficam persistidas (volume Docker `dp_keys`).
# Perder esse volume = perder acesso a CertificadoSenha e CscToken já gravados.
# Já configurado no docker-compose.yml; só ajuste se você mudar o mount point.
DataProtection__KeysPath=/app/dpkeys

# === Worker de atualização da tabela NCM (opcional) ===
# Vazio = worker desativado. Para ativar, escolha uma das duas fontes:
#   Ncm__UpdateSourceUrl: JSON HTTPS no formato Portal Único Siscomex
#   Ncm__LocalFilePath:   caminho dentro do container para JSON local
Ncm__UpdateSourceUrl=
Ncm__LocalFilePath=
Ncm__UpdateIntervalDays=7
Ncm__UpdateOnStartup=false

# === Monitoramento (opcional) ===
# Vazio = SDK do Sentry inativo, sem custo. Preencha com o DSN do projeto em sentry.io.
SENTRY_DSN=

# === Email transacional (opcional — Resend) ===
# Vazio = IEmailService loga um warning e não envia nada. Só é necessário quando algum
# fluxo de email for de fato implementado (hoje nenhum é disparado).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# === Cifragem das chaves de Data Protection em repouso (opcional, recomendado em produção) ===
# Sem isso, em hosts sem disco persistente (DataProtection__KeysPath vazio) as chaves ficam na
# tabela DataProtectionKeys do Postgres sem cifragem adicional — quem tiver acesso de leitura ao
# banco decifra CertificadoSenha/CscToken de todas as empresas. Gere um certificado autoassinado
# e cole aqui o PFX em base64 (ver docs/deploy-producao.md):
#   openssl req -x509 -newkey rsa:2048 -keyout dp.key -out dp.crt -days 3650 -nodes -subj "/CN=NfeSaas-DP"
#   openssl pkcs12 -export -out dp.pfx -inkey dp.key -in dp.crt -passout pass:SUA_SENHA
#   base64 -i dp.pfx | tr -d '\n'
DATA_PROTECTION_CERT_BASE64=
DATA_PROTECTION_CERT_PASSWORD=
