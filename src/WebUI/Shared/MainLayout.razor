@inherits LayoutComponentBase
@using NfeSaas.WebUI.Theme
@inject IAuthService AuthService
@inject IEscritorioService EscritorioService
@inject IPersonalizacaoService Personalizacao
@inject NavigationManager Nav
@inject ILocalStorageService Storage
@inject AuthenticationStateProvider AuthStateProvider

<MudThemeProvider Theme="NfeFlowTheme.Instance" @bind-IsDarkMode="_isDarkMode" />
<MudDialogProvider />
<MudSnackbarProvider />

<AuthorizeView>
    <Authorized>
        <MudLayout>
            <MudAppBar Elevation="1">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                               OnClick="@ToggleDrawer" />
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="ml-3">
                    <svg width="26" height="26" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <rect width="64" height="64" rx="14" fill="rgba(255,255,255,0.12)"/>
                        <polygon points="18,14 30,14 46,50 34,50" fill="#C08A2E"/>
                        <rect x="18" y="14" width="8" height="36" fill="#FFFFFF"/>
                        <rect x="38" y="14" width="8" height="36" fill="#FFFFFF"/>
                    </svg>
                    <MudText Typo="Typo.h6" Class="nfeflow-wordmark">NFeFlow</MudText>
                </MudStack>
                <MudSpacer />
                @if (_empresaSelecionada != null)
                {
                    <div style="display:flex; align-items:center; gap:6px; background:rgba(0,0,0,0.18); border-radius:8px; padding:4px 10px; margin-right:8px; max-width:300px">
                        <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" Style="color:rgba(255,255,255,0.7); flex-shrink:0" />
                        @if (_empresas != null && _empresas.Count > 1)
                        {
                            <div style="min-width:0; flex:1">
                                <MudSelect T="Guid" Value="_empresaIdSelecionada" ValueChanged="TrocarEmpresa"
                                           Variant="Variant.Text" Dense="true" Margin="Margin.Dense"
                                           DisableUnderLine="true"
                                           Style="color:white; font-weight:600; font-size:13px; margin:0; padding:0">
                                    @foreach (var e in _empresas)
                                    {
                                        <MudSelectItem Value="@e.Id">@NomeExibicao(e)</MudSelectItem>
                                    }
                                </MudSelect>
                                <div style="color:rgba(255,255,255,0.65); font-size:10px; padding-left:2px; margin-top:-2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis">
                                    @_empresas.FirstOrDefault(e => e.Id == _empresaIdSelecionada)?.Cnpj
                                </div>
                            </div>
                        }
                        else
                        {
                            <div style="min-width:0">
                                <div style="color:white; font-weight:600; font-size:13px; line-height:1.3; white-space:nowrap; overflow:hidden; text-overflow:ellipsis">
                                    @NomeExibicao(_empresaSelecionada)
                                </div>
                                <div style="color:rgba(255,255,255,0.65); font-size:10px; line-height:1.3; white-space:nowrap">
                                    @_empresaSelecionada.Cnpj
                                </div>
                            </div>
                        }
                    </div>
                }
                <MudTooltip Text="@(_isDarkMode ? "Tema claro" : "Tema escuro")">
                    <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                                   Color="Color.Inherit" OnClick="ToggleTema" />
                </MudTooltip>
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="Logout" Title="Sair" />
            </MudAppBar>

            <MudDrawer @bind-Open="_drawerOpen" Elevation="2" Variant="DrawerVariant.Mini" ClipMode="DrawerClipMode.Always">
                <MudNavMenu>
                    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
                    <MudNavLink Href="/emitir" Icon="@Icons.Material.Filled.NoteAdd">Emitir NF-e</MudNavLink>
                    <MudNavLink Href="/notas" Icon="@Icons.Material.Filled.Receipt">Notas Emitidas</MudNavLink>
                    @if (_perfil.MostrarCadastroProdutos || _perfil.MostrarCadastroClientes || _perfil.MostrarInutilizacoes)
                    {
                        <MudDivider />
                    }
                    @if (_perfil.MostrarCadastroProdutos)
                    {
                        <MudNavLink Href="/produtos" Icon="@Icons.Material.Filled.Inventory">Produtos</MudNavLink>
                    }
                    @if (_perfil.MostrarCadastroClientes)
                    {
                        <MudNavLink Href="/clientes" Icon="@Icons.Material.Filled.PeopleAlt">Destinatários</MudNavLink>
                    }
                    @if (_perfil.MostrarInutilizacoes)
                    {
                        <MudNavLink Href="/inutilizacoes" Icon="@Icons.Material.Filled.Block">Inutilizações</MudNavLink>
                    }
                    <MudDivider />
                    <MudNavLink Href="/empresa" Icon="@Icons.Material.Filled.Business">Config. Empresa</MudNavLink>
                    @if (!_perfil.ConfiguracaoConcluida)
                    {
                        <MudTooltip Text="Configuração inicial pendente">
                            <MudBadge Color="Color.Warning" Dot="true" Overlap="true" Class="mud-width-full">
                                <MudNavLink Href="/configuracao-inicial" Icon="@Icons.Material.Filled.Tune">Personalização</MudNavLink>
                            </MudBadge>
                        </MudTooltip>
                    }
                    else
                    {
                        <MudNavLink Href="/configuracao-inicial" Icon="@Icons.Material.Filled.Tune">Personalização</MudNavLink>
                    }
                    <MudNavLink Href="/certificado" Icon="@Icons.Material.Filled.Security">Certificado Digital</MudNavLink>
                    <AuthorizeView Roles="Admin" Context="adminCtx">
                        <Authorized>
                            <MudDivider />
                            <MudText Typo="Typo.overline" Class="px-4 pt-2 pb-1" Style="color:var(--mud-palette-text-secondary);font-size:10px">ADMINISTRAÇÃO</MudText>
                            <MudNavLink Href="/empresas" Icon="@Icons.Material.Filled.Apartment">Empresas Clientes</MudNavLink>
                            <MudNavLink Href="/usuarios" Icon="@Icons.Material.Filled.People">Usuários</MudNavLink>
                        </Authorized>
                    </AuthorizeView>
                </MudNavMenu>
            </MudDrawer>

            <MudMainContent>
                <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-4">
                    <div class="nfeflow-route-transition" @key="Nav.Uri">
                        @Body
                    </div>
                </MudContainer>
            </MudMainContent>
        </MudLayout>
    </Authorized>
    <NotAuthorized>
        @Body
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode;
    private List<EmpresaResumoDto>? _empresas;
    private Guid _empresaIdSelecionada;
    private EmpresaResumoDto? _empresaSelecionada;
    private PerfilSimplificado _perfil = PerfilSimplificado.Default();

    string NomeExibicao(EmpresaResumoDto? e) =>
        string.IsNullOrWhiteSpace(e?.NomeFantasia) ? e?.RazaoSocial ?? "" : e.NomeFantasia;

    protected override async Task OnInitializedAsync()
    {
        _isDarkMode = await Storage.GetItemAsync<bool?>("tema_escuro") ?? false;

        _empresas = await EscritorioService.GetEmpresasAsync();
        var empresaIdStr = await Storage.GetItemAsStringAsync("empresa_id");
        if (Guid.TryParse(empresaIdStr, out var eid))
        {
            _empresaIdSelecionada = eid;
            _empresaSelecionada = _empresas?.FirstOrDefault(e => e.Id == eid);
        }
        _perfil = await Personalizacao.ObterPerfilAsync();
    }

    void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    async Task ToggleTema()
    {
        _isDarkMode = !_isDarkMode;
        await Storage.SetItemAsync("tema_escuro", _isDarkMode);
    }

    async Task TrocarEmpresa(Guid empresaId)
    {
        _empresaIdSelecionada = empresaId;
        _empresaSelecionada = _empresas?.FirstOrDefault(e => e.Id == empresaId);
        await AuthService.SelecionarEmpresaAsync(empresaId);
        await Personalizacao.InvalidarAsync(); // cada empresa tem sua personalização
        ((JwtAuthStateProvider)AuthStateProvider).NotifyAuthStateChanged();
        Nav.NavigateTo("/", forceLoad: true);
    }

    async Task Logout()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: true);
    }
}
