    <rect x="8" y="18" width="3.5" height="6" rx="1" fill="#3FB39A"/><rect x="108" y="20" width="3.5" height="6" rx="1" fill="#5B8AD1"/>
  </g>
  <rect x="16" y="124" width="88" height="4" rx="2" fill="#C08A2E"/>
  <g class="corpo">
