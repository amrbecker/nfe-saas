      <path d="M55.5 54.5 L64.5 54.5 L60 61.4 Z" fill="#CDBE92" stroke="#3B2A1C" stroke-width=".8" stroke-linejoin="round"/>
      <g class="caneta" transform="rotate(36 90 23)"><rect x="80" y="21.5" width="18" height="3.4" rx="1.2" fill="#0F6E5E"/><path d="M98 21.5 l4 1.7 l-4 1.7 Z" fill="#C08A2E"/></g>
