      <path d="M52 106 L50 123 M68 106 L70 123" stroke-width="3"/>
      <path d="M45 124 L50 123 L54 124 M66 124 L70 123 L75 124" stroke-width="2.5"/>
    </g>
    <ellipse cx="60" cy="80" rx="30" ry="32" fill="#8A6A4B" stroke="#3B2A1C" stroke-width="1.2"/>
    <ellipse cx="60" cy="87" rx="19" ry="22" fill="#E9DCC4"/>
    <g fill="#B89A74">
      <ellipse cx="52" cy="77" rx="2.2" ry="1.4"/><ellipse cx="60" cy="75" rx="2.2" ry="1.4"/><ellipse cx="68" cy="77" rx="2.2" ry="1.4"/>
      <ellipse cx="48" cy="86" rx="2" ry="1.3"/><ellipse cx="56" cy="85" rx="2.2" ry="1.4"/><ellipse cx="64" cy="85" rx="2.2" ry="1.4"/><ellipse cx="72" cy="86" rx="2" ry="1.3"/>
      <ellipse cx="52" cy="95" rx="2" ry="1.3"/><ellipse cx="60" cy="94" rx="2.2" ry="1.4"/><ellipse cx="68" cy="95" rx="2" ry="1.3"/>
    </g>
    <path class="asa-esq" d="M33 66 C21 83 24 103 42 111 C37 96 37 81 41 68 Z" fill="#6E5238" stroke="#3B2A1C" stroke-width="1"/>
    <g class="braco">
      <path d="M87 66 C99 83 96 103 78 111 C83 96 83 81 79 68 Z" fill="#6E5238" stroke="#3B2A1C" stroke-width="1"/>
      <g class="xicara">
        <g class="vapor" fill="none" stroke="#D7DEEE" stroke-width="1.6" stroke-linecap="round" opacity=".9">
