      </g>
    </g>
    <g class="cabeca">
      <ellipse cx="60" cy="44" rx="33" ry="27" fill="#8A6A4B" stroke="#3B2A1C" stroke-width="1.2"/>
      <g fill="#F3EAD8"><circle cx="40" cy="27" r="1.6"/><circle cx="49" cy="21" r="1.6"/><circle cx="60" cy="19" r="1.7"/><circle cx="71" cy="21" r="1.6"/><circle cx="80" cy="27" r="1.6"/><circle cx="55" cy="25" r="1.2"/><circle cx="65" cy="25" r="1.2"/></g>
      <path d="M60 37 C52 27 30 28 30 46 C30 62 48 66 60 58 C72 66 90 62 90 46 C90 28 68 27 60 37 Z" fill="#EFE3CC"/>
