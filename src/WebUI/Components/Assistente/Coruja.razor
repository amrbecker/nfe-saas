        <g class="pupila"><circle cx="73" cy="46" r="4.6" fill="#1B1712"/><circle cx="75" cy="44" r="1.5" fill="#fff"/></g>
        <ellipse class="palpebra" cx="73" cy="46" rx="10.2" ry="10.2" fill="#8A6A4B"/>
        <path class="cilio" d="M64 49 Q73 55 82 49" fill="none" stroke="#3B2A1C" stroke-width="1.6" stroke-linecap="round"/>
