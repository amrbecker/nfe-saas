        <rect x="21" y="38" width="11" height="17" rx="4.5" fill="#0F6E5E" stroke="#0A4A3F" stroke-width="1"/>
        <rect x="88" y="38" width="11" height="17" rx="4.5" fill="#0F6E5E" stroke="#0A4A3F" stroke-width="1"/>
      </g>
    </g>
  </g>
</svg>
</span>

@code {
    [Parameter] public EstadoOri Estado { get; set; } = EstadoOri.Cafe;
    [Parameter] public int Largura { get; set; } = 72;
    [Parameter] public string? Classe { get; set; }

    private string NomeEstado => Estado switch
    {
        EstadoOri.Cochilando => "cochilando",
        EstadoOri.Atenta => "atenta",
        EstadoOri.Pensando => "pensando",
        EstadoOri.Falando => "falando",
        EstadoOri.Preocupada => "preocupada",
        EstadoOri.Comemorando => "comemorando",
        EstadoOri.Dormindo => "dormindo",
        EstadoOri.Silenciada => "silenciada",
        _ => "cafe"
    };
}
