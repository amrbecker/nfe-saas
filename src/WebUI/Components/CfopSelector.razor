@using NfeSaas.Domain.Enums
@using NfeSaas.Domain.Services

<MudAutocomplete T="CfopOpcao" Value="_selecionado" ValueChanged="OnSelecionado"
                 Label="@Label"
                 Variant="Variant.Outlined"
                 SearchFunc="Buscar"
                 ToStringFunc="@(c => c == null ? "" : c.Display)"
                 ResetValueOnEmptyText="false"
                 CoerceText="false"
                 CoerceValue="false"
                 Clearable="true"
                 ShowProgressIndicator="false"
                 DebounceInterval="200"
                 MinCharacters="0"
                 Required="@Required"
                 ReadOnly="@ReadOnly"
                 Disabled="@Disabled"
                 HelperText="@HelperContexto"
                 Error="@(!string.IsNullOrEmpty(ErroExterno) || !string.IsNullOrEmpty(_erroInterno))"
                 ErrorText="@(ErroExterno ?? _erroInterno)"
                 Adornment="Adornment.End"
                 AdornmentIcon="@_icone"
                 AdornmentColor="@_corIcone"
                 Class="@Class">
    <ItemTemplate Context="cfop">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Style="width:100%">
            <MudChip Size="Size.Small" Color="@CorChip(cfop)" Variant="Variant.Filled"
                     Style="font-family:monospace;min-width:70px;font-weight:600">
                @cfop.Codigo[..1].@cfop.Codigo[1..]
            </MudChip>
            <div style="flex:1;min-width:0">
                <MudText Typo="Typo.body2" Style="white-space:normal;line-height:1.3">@cfop.Descricao</MudText>
                <MudText Typo="Typo.caption" Style="color:#888">
                    @(cfop.Interestadual ? "Interestadual" : "Intraestadual") · @(cfop.Saida ? "Saída" : "Entrada")
                </MudText>
            </div>
        </MudStack>
    </ItemTemplate>
    <NoItemsTemplate>
        <MudText Typo="Typo.caption" Class="pa-2" Style="color:#888">
            Nenhum CFOP corresponde ao termo digitado.
        </MudText>
    </NoItemsTemplate>
</MudAutocomplete>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    [Parameter] public string? UfEmitente { get; set; }
    [Parameter] public string? UfDestino { get; set; }
    [Parameter] public TipoOperacao Operacao { get; set; } = TipoOperacao.Saida;
    [Parameter] public FinalidadeNota Finalidade { get; set; } = FinalidadeNota.Normal;
    [Parameter] public bool Exterior { get; set; }

    [Parameter] public string Label { get; set; } = "CFOP";
    [Parameter] public string? ErroExterno { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// Se true, ao mudar o contexto (UF/operação) e o CFOP atual deixar de bater com o prefixo
    /// esperado, sugere automaticamente o CFOP mais provável.
    /// </summary>
    [Parameter] public bool AutoSugerir { get; set; } = true;

    private CfopOpcao? _selecionado;
    private string? _erroInterno;
    private string _ultimoContexto = "";

    private string _icone =>
        _selecionado != null ? Icons.Material.Filled.CheckCircle :
        !string.IsNullOrEmpty(_erroInterno) ? Icons.Material.Filled.Warning :
        Icons.Material.Filled.SwapHoriz;

    private Color _corIcone =>
        _selecionado != null ? Color.Success :
        !string.IsNullOrEmpty(_erroInterno) ? Color.Warning :
        Color.Primary;

    private string HelperContexto
    {
        get
        {
            if (string.IsNullOrWhiteSpace(UfEmitente) || string.IsNullOrWhiteSpace(UfDestino))
                return "Digite código (ex: 5102) ou descrição";

            var abrangencia = string.Equals(UfEmitente, UfDestino, StringComparison.OrdinalIgnoreCase)
                ? "Intraestadual"
                : $"Interestadual ({UfEmitente}→{UfDestino})";
            var sentido = Operacao == TipoOperacao.Saida ? "Saída" : "Entrada";
            var fin = Finalidade == FinalidadeNota.Devolucao ? " · Devolução" : "";
            return $"{abrangencia} · {sentido}{fin}";
        }
    }

    private Color CorChip(CfopOpcao c) =>
        c.Saida ? (c.Interestadual ? Color.Info : Color.Primary)
               : (c.Interestadual ? Color.Warning : Color.Secondary);

    protected override async Task OnParametersSetAsync()
    {
        var ctx = $"{UfEmitente}|{UfDestino}|{Operacao}|{Finalidade}|{Exterior}";
        var mudouContexto = _ultimoContexto != ctx;
        _ultimoContexto = ctx;

        // Sincroniza Value (vindo de fora) → _selecionado
        var d = new string((Value ?? "").Where(char.IsDigit).ToArray());
        if (d.Length == 4)
        {
            if (_selecionado?.Codigo != d)
            {
                var todos = CfopValidator.ListarTodos();
                if (todos.TryGetValue(d, out var info))
                {
                    _selecionado = new CfopOpcao(d, info.Descricao, info.Interestadual, info.Saida);
                    _erroInterno = ValidarContexto(_selecionado);
                }
                else
                {
                    _selecionado = null;
                    _erroInterno = $"CFOP {d} não está no catálogo.";
                }
            }
            else
            {
                _erroInterno = ValidarContexto(_selecionado);
            }
        }
        else if (string.IsNullOrEmpty(Value))
        {
            _selecionado = null;
            _erroInterno = null;
        }

        // Auto-sugerir quando o contexto muda e o CFOP atual não bate (ou está vazio).
        if (AutoSugerir && mudouContexto && !ReadOnly && !Disabled
            && !string.IsNullOrWhiteSpace(UfEmitente) && !string.IsNullOrWhiteSpace(UfDestino))
        {
            var precisa = _selecionado == null || !string.IsNullOrEmpty(_erroInterno);
            if (precisa)
            {
                var sugestao = CfopValidator.Sugerir(UfEmitente, UfDestino, Operacao, Finalidade, Exterior).FirstOrDefault();
                if (sugestao != null)
                {
                    _selecionado = sugestao;
                    _erroInterno = null;
                    await ValueChanged.InvokeAsync(sugestao.Codigo);
                }
            }
        }
    }

    Task<IEnumerable<CfopOpcao>> Buscar(string? termo)
    {
        // Sem termo → mostra sugestões contextuais (top 15) priorizando o cenário atual.
        if (string.IsNullOrWhiteSpace(termo))
        {
            if (!string.IsNullOrWhiteSpace(UfEmitente) && !string.IsNullOrWhiteSpace(UfDestino))
                return Task.FromResult(CfopValidator.Sugerir(UfEmitente, UfDestino, Operacao, Finalidade, Exterior).Take(15));
            return Task.FromResult(CfopValidator.ListarTodos()
                .Take(15)
                .Select(kv => new CfopOpcao(kv.Key, kv.Value.Descricao, kv.Value.Interestadual, kv.Value.Saida)));
        }

        var t = termo.Trim();
        var digitos = new string(t.Where(char.IsDigit).ToArray());
        var todos = CfopValidator.ListarTodos();

        if (digitos.Length >= 1 && digitos.Length == t.Length)
        {
            // Busca por código (prefixo)
            return Task.FromResult(todos
                .Where(kv => kv.Key.StartsWith(digitos))
                .Select(kv => new CfopOpcao(kv.Key, kv.Value.Descricao, kv.Value.Interestadual, kv.Value.Saida))
                .Take(20));
        }

        // Busca por descrição
        return Task.FromResult(todos
            .Where(kv => kv.Value.Descricao.Contains(t, StringComparison.OrdinalIgnoreCase))
            .Select(kv => new CfopOpcao(kv.Key, kv.Value.Descricao, kv.Value.Interestadual, kv.Value.Saida))
            .Take(20));
    }

    async Task OnSelecionado(CfopOpcao? opcao)
    {
        _selecionado = opcao;
        _erroInterno = opcao == null ? null : ValidarContexto(opcao);
        await ValueChanged.InvokeAsync(opcao?.Codigo ?? "");
    }

    /// <summary>
    /// Avisa (mas não bloqueia) se o CFOP escolhido não bate com o contexto da operação.
    /// </summary>
    string? ValidarContexto(CfopOpcao? cfop)
    {
        if (cfop == null) return null;
        if (string.IsNullOrWhiteSpace(UfEmitente) || string.IsNullOrWhiteSpace(UfDestino)) return null;

        var interestadual = !string.Equals(UfEmitente, UfDestino, StringComparison.OrdinalIgnoreCase);
        var saidaEsperada = Operacao == TipoOperacao.Saida;

        if (cfop.Saida != saidaEsperada)
            return $"CFOP de {(cfop.Saida ? "saída" : "entrada")} numa operação de {(saidaEsperada ? "saída" : "entrada")}.";
        if (cfop.Interestadual != interestadual && !Exterior)
            return $"CFOP {(cfop.Interestadual ? "interestadual" : "intraestadual")} para operação {(interestadual ? "interestadual" : "intraestadual")}.";

        return null;
    }
}
