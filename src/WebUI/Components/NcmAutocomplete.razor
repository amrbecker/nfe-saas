@inject INcmService NcmService
@implements IDisposable

<MudAutocomplete T="NcmDto" Value="_selecionado" ValueChanged="OnSelecionado"
                 Label="@Label"
                 Variant="Variant.Outlined"
                 SearchFunc="BuscarServidor"
                 ToStringFunc="@(n => n == null ? "" : $"{FormatarCodigo(n.Codigo)} — {n.Descricao}")"
                 ResetValueOnEmptyText="false"
                 CoerceText="false"
                 CoerceValue="false"
                 Clearable="true"
                 ShowProgressIndicator="true"
                 DebounceInterval="350"
                 MinCharacters="2"
                 Required="@Required"
                 ReadOnly="@ReadOnly"
                 Disabled="@Disabled"
                 HelperText="@HelperText"
                 Error="@(!string.IsNullOrEmpty(ErroExterno) || !string.IsNullOrEmpty(_erroInterno))"
                 ErrorText="@(ErroExterno ?? _erroInterno)"
                 Adornment="Adornment.End"
                 AdornmentIcon="@_icone"
                 AdornmentColor="@_corIcone"
                 Class="@Class">
    <ItemTemplate Context="ncm">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Style="width:100%">
            <MudChip Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Style="font-family:monospace;min-width:90px">
                @FormatarCodigo(ncm.Codigo)
            </MudChip>
            <div style="flex:1;min-width:0">
                <MudText Typo="Typo.body2" Style="white-space:normal;line-height:1.3">@ncm.Descricao</MudText>
                @if (ncm.ExigeCest)
                {
                    <MudText Typo="Typo.caption" Style="color:#d97706">⚠ exige CEST</MudText>
                }
            </div>
        </MudStack>
    </ItemTemplate>
    <NoItemsTemplate>
        <MudText Typo="Typo.caption" Class="pa-2" Style="color:#888">
            Nenhum NCM encontrado. Digite ao menos 2 caracteres (código ou descrição).
        </MudText>
    </NoItemsTemplate>
</MudAutocomplete>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public EventCallback<NcmDto> NcmSelecionado { get; set; }
    [Parameter] public string Label { get; set; } = "NCM";
    [Parameter] public string? HelperText { get; set; } = "Digite código (ex: 8517) ou descrição (ex: \"telefone\")";
    [Parameter] public string? ErroExterno { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }

    private NcmDto? _selecionado;
    private string? _erroInterno;
    private bool _validando;
    private string _ultimoValidado = "";
    private CancellationTokenSource? _cts;

    private string _icone =>
        _validando ? Icons.Material.Filled.HourglassEmpty :
        _selecionado != null ? Icons.Material.Filled.CheckCircle :
        !string.IsNullOrEmpty(_erroInterno) ? Icons.Material.Filled.Error :
        Icons.Material.Filled.Search;

    private Color _corIcone =>
        _validando ? Color.Default :
        _selecionado != null ? Color.Success :
        !string.IsNullOrEmpty(_erroInterno) ? Color.Error :
        Color.Primary;

    protected override async Task OnParametersSetAsync()
    {
        var d = new string((Value ?? "").Where(char.IsDigit).ToArray());
        if (d.Length == 8 && d != _ultimoValidado)
        {
            _ultimoValidado = d;
            await ValidarAtual(d);
        }
        else if (string.IsNullOrEmpty(Value))
        {
            _selecionado = null;
            _erroInterno = null;
        }
    }

    async Task<IEnumerable<NcmDto>> BuscarServidor(string? termo)
    {
        if (string.IsNullOrWhiteSpace(termo) || termo.Trim().Length < 2)
            return Array.Empty<NcmDto>();
        return await NcmService.BuscarAsync(termo, 15);
    }

    async Task OnSelecionado(NcmDto? ncm)
    {
        _selecionado = ncm;
        _erroInterno = null;
        var codigo = ncm?.Codigo ?? "";
        _ultimoValidado = codigo;
        await ValueChanged.InvokeAsync(codigo);
        if (ncm != null) await NcmSelecionado.InvokeAsync(ncm);
    }

    async Task ValidarAtual(string codigo)
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        _validando = true;
        StateHasChanged();

        try
        {
            var resultado = await NcmService.ValidarAsync(codigo);
            _selecionado = resultado;
            _erroInterno = resultado == null ? $"NCM {codigo} não consta na tabela oficial." : null;
            // Propaga o DTO carregado para o componente pai poder cruzar com CFOP/CEST,
            // independente de o NCM ter vindo do dropdown ou do Value externo.
            if (resultado != null)
                await NcmSelecionado.InvokeAsync(resultado);
        }
        catch { _erroInterno = "Erro ao validar NCM."; }
        finally
        {
            _validando = false;
            StateHasChanged();
        }
    }

    static string FormatarCodigo(string c)
    {
        var d = new string(c.Where(char.IsDigit).ToArray());
        return d.Length == 8 ? $"{d[..4]}.{d[4..6]}.{d[6..]}" : d;
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
