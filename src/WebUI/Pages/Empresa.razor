@page "/empresa"
@attribute [Authorize]
@inject IEmpresaService EmpresaService
@inject ISnackbar Snackbar
@using NfeSaas.Domain.Enums

<PageTitle>Empresa - NfeSaas</PageTitle>
<MudText Typo="Typo.h5" Class="mb-4">Dados da Empresa</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudCard Elevation="2">
        <MudCardContent>
            <MudAlert Severity="Severity.Info" Class="mb-3">
                Para alterar dados cadastrais, entre em contato com o suporte.
            </MudAlert>

            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField Value="@_empresa?.RazaoSocial"
                                  Label="Razão Social" Variant="Variant.Outlined" ReadOnly="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField Value="@_empresa?.NomeFantasia"
                                  Label="Nome Fantasia" Variant="Variant.Outlined" ReadOnly="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField Value="@_empresa?.Cnpj"
                                  Label="CNPJ" Variant="Variant.Outlined" ReadOnly="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField Value="@_empresa?.InscricaoEstadual"
                                  Label="Inscrição Estadual" Variant="Variant.Outlined" ReadOnly="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField Value="@_empresa?.Email"
                                  Label="E-mail" Variant="Variant.Outlined" ReadOnly="true" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField Value="@((AmbienteSefaz?)_empresa?.AmbienteSefaz == AmbienteSefaz.Producao ? "Produção" : "Homologação")"
                                  Label="Ambiente SEFAZ" Variant="Variant.Outlined" ReadOnly="true" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField Value="@_empresa?.UltimoNumeronFe.ToString()"
                                  Label="Último Número NF-e" Variant="Variant.Outlined" ReadOnly="true" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField Value="@_empresa?.UltimoNumeronFCe.ToString()"
                                  Label="Último Número NFC-e" Variant="Variant.Outlined" ReadOnly="true" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField Value="@(_empresa?.CertificadoValido == true ? "✓ Certificado Válido" : "✗ Sem Certificado")"
                                  Label="Certificado A1"
                                  Variant="Variant.Outlined" ReadOnly="true"
                                  Style="@(_empresa?.CertificadoValido == true ? "color:green" : "color:red")" />
                </MudItem>
            </MudGrid>
        </MudCardContent>
        <MudCardActions>
            <MudButton Href="/certificado" StartIcon="@Icons.Material.Filled.Security" Color="Color.Primary" Variant="Variant.Outlined">
                Gerenciar Certificado
            </MudButton>
        </MudCardActions>
    </MudCard>
}

@code {
    private EmpresaDetalheDto? _empresa;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try { _empresa = await EmpresaService.GetEmpresaAsync(); }
        catch { Snackbar.Add("Erro ao carregar dados da empresa.", Severity.Error); }
        finally { _loading = false; }
    }
}
