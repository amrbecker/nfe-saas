@page "/certificado"
@attribute [Authorize]
@inject IEmpresaService EmpresaService
@inject ApiClient Api
@inject ISnackbar Snackbar
@using System.Net.Http.Json
@using System.Text.Json

<PageTitle>Certificado Digital - NfeSaas</PageTitle>
<MudText Typo="Typo.h5" Class="mb-4">Certificado Digital A1</MudText>

<MudGrid>
    <!-- Status atual -->
    <MudItem xs="12" md="5">
        <MudCard Elevation="2">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle1"><b>Status do Certificado</b></MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                @if (_statusLoading)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                }
                else if (_status != null)
                {
                    <MudGrid>
                        <MudItem xs="12">
                            <MudChip Color="@(_certValido ? Color.Success : Color.Error)" Size="Size.Medium">
                                @(_certValido ? "✓ Válido" : "✗ Inválido ou não configurado")
                            </MudChip>
                        </MudItem>
                        @if (_status.NomeTitular != null)
                        {
                            <MudItem xs="12"><MudText><b>Titular:</b> @_status.NomeTitular</MudText></MudItem>
                            @if (_status.Cnpj != null)
                            {
                                <MudItem xs="12"><MudText><b>CNPJ:</b> @_status.Cnpj</MudText></MudItem>
                            }
                            <MudItem xs="12">
                                <MudText Color="@(_certVencendo ? Color.Warning : Color.Default)">
                                    <b>Validade:</b> @_status.Validade?.ToLocalTime().ToString("dd/MM/yyyy")
                                    @if (_certVencendo) { <span> ⚠️ Vencendo em breve!</span> }
                                </MudText>
                            </MudItem>
                        }
                        @if (!string.IsNullOrEmpty(_status.Mensagem))
                        {
                            <MudItem xs="12"><MudAlert Severity="Severity.Warning" Dense="true">@_status.Mensagem</MudAlert></MudItem>
                        }
                    </MudGrid>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- Upload -->
    <MudItem xs="12" md="7">
        <MudCard Elevation="2">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle1"><b>Carregar Novo Certificado</b></MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudAlert Severity="Severity.Info" Class="mb-3">
                    Aceito apenas arquivos <b>.pfx</b> ou <b>.p12</b> (Certificado A1). O arquivo é armazenado de forma segura e criptografada.
                </MudAlert>

                <InputFile id="certFileInput" OnChange="ArquivoSelecionado" style="display:none" accept=".pfx,.p12" />
                <label for="certFileInput" class="mb-3" style="display:block">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.UploadFile"
                               HtmlTag="span">
                        Selecionar Arquivo (.pfx / .p12)
                    </MudButton>
                </label>

                @if (_arquivo != null)
                {
                    <MudChip Icon="@Icons.Material.Filled.InsertDriveFile" Size="Size.Small" Class="mb-3">
                        @_arquivo.Name (@(_arquivo.Size / 1024) KB)
                    </MudChip>
                }

                <MudTextField @bind-Value="_senha" Label="Senha do Certificado" Variant="Variant.Outlined"
                              InputType="@(_showSenha ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showSenha ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="@(() => _showSenha = !_showSenha)"
                              Class="mb-3" Required />

                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="FazerUpload"
                           Disabled="@(_arquivo == null || string.IsNullOrEmpty(_senha) || _uploading)"
                           StartIcon="@Icons.Material.Filled.CloudUpload">
                    @if (_uploading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Validando e enviando...</span>
                    }
                    else
                    {
                        <span>Enviar Certificado</span>
                    }
                </MudButton>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private bool _statusLoading = true;
    private CertificadoStatusDto? _status;

    private IBrowserFile? _arquivo;
    private string _senha = "";
    private bool _showSenha;
    private bool _uploading;

    private bool _certValido => _status?.Valido == true;
    private bool _certVencendo => _status?.Validade.HasValue == true
        && _status.Validade!.Value < DateTime.UtcNow.AddDays(30);

    protected override async Task OnInitializedAsync()
    {
        await CarregarStatus();
    }

    async Task CarregarStatus()
    {
        _statusLoading = true;
        _status = await EmpresaService.GetCertificadoStatusAsync();
        _statusLoading = false;
    }

    static async Task<string> ExtrairMensagemErro(HttpResponseMessage response)
    {
        try
        {
            var body = await response.Content.ReadAsStringAsync();
            var doc = JsonDocument.Parse(body);
            if (doc.RootElement.TryGetProperty("message", out var msg))
                return msg.GetString() ?? "Erro desconhecido.";
            if (doc.RootElement.TryGetProperty("title", out var title))
                return title.GetString() ?? "Erro desconhecido.";
            return body;
        }
        catch
        {
            return $"Erro {(int)response.StatusCode}: {response.ReasonPhrase}";
        }
    }

    void ArquivoSelecionado(InputFileChangeEventArgs e) => _arquivo = e.File;

    async Task FazerUpload()
    {
        if (_arquivo == null) return;
        _uploading = true;
        try
        {
            using var ms = new MemoryStream();
            await _arquivo.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(ms);
            var bytes = ms.ToArray();

            var form = new MultipartFormDataContent();
            form.Add(new ByteArrayContent(bytes), "arquivo", _arquivo.Name);
            form.Add(new StringContent(_senha), "senha");

            var response = await Api.PostMultipartAsync("api/empresa/certificado/upload", form);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Certificado instalado com sucesso!", Severity.Success);
                await CarregarStatus();
                _arquivo = null;
                _senha = "";
            }
            else
            {
                var mensagem = await ExtrairMensagemErro(response);
                Snackbar.Add(mensagem, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao enviar certificado: {ex.Message}", Severity.Error);
        }
        finally
        {
            _uploading = false;
        }
    }
}
