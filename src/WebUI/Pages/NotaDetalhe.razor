@page "/notas/{Id:guid}"
@attribute [Authorize]
@inject INotaFiscalService NotaService
@inject IEventoFiscalService EventoService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Detalhe da Nota - NfeSaas</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_nota == null)
{
    <MudAlert Severity="Severity.Error">Nota fiscal não encontrada.</MudAlert>
    <MudButton Href="/notas" StartIcon="@Icons.Material.Filled.ArrowBack">Voltar</MudButton>
}
else
{
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-4" />

    <MudGrid>
        <!-- Cabeçalho -->
        <MudItem xs="12">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">
                            @(_nota.Tipo == NfeSaas.Domain.Enums.TipoNota.NFe ? "NF-e" : "NFC-e") — Série @_nota.Serie.ToString("D3") — Número @_nota.Numero.ToString("D9")
                        </MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudChip Color="@GetCorSituacao(_nota.Situacao)" Size="Size.Medium">@NomeSituacao(_nota.Situacao)</MudChip>
                        @if (_nota.Ambiente == NfeSaas.Domain.Enums.AmbienteSefaz.Homologacao)
                        {
                            <MudChip Color="Color.Warning" Size="Size.Small">HOMOLOGAÇÃO</MudChip>
                        }
                        @if (_nota.DentroPeriodoRetencao && _nota.DataDescarteAutorizado.HasValue)
                        {
                            <MudChip Color="Color.Info" Size="Size.Small" Icon="@Icons.Material.Filled.Lock"
                                     Title="@($"Documento fiscal sob retenção legal até {_nota.DataDescarteAutorizado:dd/MM/yyyy}")">
                                Imutável
                            </MudChip>
                        }
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudText><b>Chave de Acesso:</b></MudText>
                            <MudText Style="font-family: monospace; font-size: 0.8rem; word-break: break-all;">
                                @(_nota.ChaveAcesso ?? "—")
                            </MudText>
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudText><b>Protocolo:</b> @(_nota.Protocolo ?? "—")</MudText>
                            <MudText><b>Data Emissão:</b> @_nota.DataEmissao.ToString("dd/MM/yyyy HH:mm")</MudText>
                        </MudItem>
                        <MudItem xs="12" md="3">
                            @if (_nota.DataAutorizacao.HasValue)
                            {
                                <MudText><b>Autorizada em:</b> @_nota.DataAutorizacao.Value.ToString("dd/MM/yyyy HH:mm")</MudText>
                            }
                            @if (!string.IsNullOrEmpty(_nota.MotivoRejeicao))
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true">@_nota.MotivoRejeicao</MudAlert>
                            }
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
                <MudCardActions>
                    @if (_nota.Situacao == NfeSaas.Domain.Enums.SituacaoNota.Autorizada)
                    {
                        <MudButton StartIcon="@Icons.Material.Filled.PictureAsPdf" Color="Color.Error"
                                   OnClick="DownloadDanfe" Variant="Variant.Outlined">DANFE PDF</MudButton>
                        <MudButton StartIcon="@Icons.Material.Filled.EditNote" Color="Color.Primary"
                                   OnClick="@(() => _mostrarDialogCce = true)" Variant="Variant.Outlined">Carta de Correção</MudButton>
                        <MudButton StartIcon="@Icons.Material.Filled.HowToVote" Color="Color.Secondary"
                                   OnClick="@(() => _mostrarDialogManif = true)" Variant="Variant.Outlined">Manifestar</MudButton>
                        <MudButton StartIcon="@Icons.Material.Filled.Email" Color="Color.Primary"
                                   OnClick="AbrirDialogEmail" Variant="Variant.Outlined">
                            @(_nota.EmailEnviadoEm.HasValue ? "Reenviar por E-mail" : "Enviar por E-mail")
                        </MudButton>
                    }
                    <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" Href="/notas" Variant="Variant.Text">Voltar</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- Destinatário -->
        <MudItem xs="12" md="6">
            <MudCard Elevation="2">
                <MudCardHeader><CardHeaderContent><MudText Typo="Typo.subtitle1"><b>Destinatário</b></MudText></CardHeaderContent></MudCardHeader>
                <MudCardContent>
                    <MudText><b>Nome:</b> @(_nota.Destinatario.RazaoSocial ?? "Consumidor Final")</MudText>
                    @if (!string.IsNullOrEmpty(_nota.Destinatario.CpfCnpj))
                    {
                        <MudText><b>CPF/CNPJ:</b> @_nota.Destinatario.CpfCnpj</MudText>
                    }
                    @if (!string.IsNullOrEmpty(_nota.Destinatario.Email))
                    {
                        <MudText><b>E-mail:</b> @_nota.Destinatario.Email</MudText>
                    }
                    @if (!string.IsNullOrEmpty(_nota.Destinatario.Cidade))
                    {
                        <MudText><b>Endereço:</b> @_nota.Destinatario.Logradouro, @_nota.Destinatario.Numero — @_nota.Destinatario.Cidade/@_nota.Destinatario.Uf</MudText>
                    }
                    @if (_nota.EmailEnviadoEm.HasValue)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Success" Class="mt-2">
                            E-mail enviado em: @_nota.EmailEnviadoEm.Value.ToString("dd/MM/yyyy HH:mm")
                        </MudText>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Totais -->
        <MudItem xs="12" md="6">
            <MudCard Elevation="2">
                <MudCardHeader><CardHeaderContent><MudText Typo="Typo.subtitle1"><b>Totais</b></MudText></CardHeaderContent></MudCardHeader>
                <MudCardContent>
                    <MudText>Produtos: <b>R$ @_nota.TotalProdutos.ToString("N2")</b></MudText>
                    @if (_nota.TotalDesconto > 0) { <MudText>Desconto: <b>R$ @_nota.TotalDesconto.ToString("N2")</b></MudText> }
                    @if (_nota.TotalFrete > 0) { <MudText>Frete: <b>R$ @_nota.TotalFrete.ToString("N2")</b></MudText> }
                    <MudText>ICMS: <b>R$ @_nota.TotalIcms.ToString("N2")</b></MudText>
                    <MudText>PIS: <b>R$ @_nota.TotalPis.ToString("N2")</b></MudText>
                    <MudText>COFINS: <b>R$ @_nota.TotalCofins.ToString("N2")</b></MudText>
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.h6" Color="Color.Primary"><b>TOTAL: R$ @_nota.TotalNota.ToString("N2")</b></MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Eventos fiscais -->
        @if (_eventos != null && _eventos.Count > 0)
        {
            <MudItem xs="12">
                <MudCard Elevation="2">
                    <MudCardHeader><CardHeaderContent><MudText Typo="Typo.subtitle1"><b>Eventos Fiscais</b></MudText></CardHeaderContent></MudCardHeader>
                    <MudCardContent>
                        <MudTable Items="_eventos" Dense="true" Striped="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>Data</MudTh>
                                <MudTh>Tipo</MudTh>
                                <MudTh>Sequencial</MudTh>
                                <MudTh>Descrição/Justificativa</MudTh>
                                <MudTh>Situação</MudTh>
                                <MudTh>Protocolo</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.DataEvento.ToString("dd/MM/yyyy HH:mm")</MudTd>
                                <MudTd>@NomeTipoEvento(context.Tipo)</MudTd>
                                <MudTd>@(context.SequencialCce?.ToString() ?? "—")</MudTd>
                                <MudTd Style="max-width:400px; word-break:break-word">@TruncarTexto(context.Justificativa, 120)</MudTd>
                                <MudTd>
                                    <MudChip Size="Size.Small" Color="@(context.Situacao == 1 ? Color.Success : Color.Error)">
                                        @(context.Situacao == 1 ? "Aceito" : "Rejeitado")
                                    </MudChip>
                                </MudTd>
                                <MudTd>@(context.Protocolo ?? context.MotivoRejeicao ?? "—")</MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }

        <!-- Itens -->
        <MudItem xs="12">
            <MudCard Elevation="2">
                <MudCardHeader><CardHeaderContent><MudText Typo="Typo.subtitle1"><b>Itens da Nota</b></MudText></CardHeaderContent></MudCardHeader>
                <MudCardContent>
                    <MudTable Items="_nota.Itens" Dense="true" Striped="true" Hover="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>#</MudTh>
                            <MudTh>Código</MudTh>
                            <MudTh>Descrição</MudTh>
                            <MudTh>NCM</MudTh>
                            <MudTh>CFOP</MudTh>
                            <MudTh>UN</MudTh>
                            <MudTh>Qtd</MudTh>
                            <MudTh>V.Unit.</MudTh>
                            <MudTh>Desconto</MudTh>
                            <MudTh>V.Total</MudTh>
                            <MudTh>ICMS</MudTh>
                            <MudTh>PIS</MudTh>
                            <MudTh>COFINS</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.NumeroItem</MudTd>
                            <MudTd>@context.CodigoProduto</MudTd>
                            <MudTd>@context.Descricao</MudTd>
                            <MudTd>@context.Ncm</MudTd>
                            <MudTd>@context.Cfop</MudTd>
                            <MudTd>@context.Unidade</MudTd>
                            <MudTd>@context.Quantidade.ToString("F2")</MudTd>
                            <MudTd>@context.ValorUnitario.ToString("F4")</MudTd>
                            <MudTd>@context.ValorDesconto.ToString("F2")</MudTd>
                            <MudTd><b>@context.ValorTotal.ToString("F2")</b></MudTd>
                            <MudTd>@context.ValorIcms.ToString("F2")</MudTd>
                            <MudTd>@context.ValorPis.ToString("F2")</MudTd>
                            <MudTd>@context.ValorCofins.ToString("F2")</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <!-- Dialog CC-e -->
    <MudDialog @bind-IsVisible="_mostrarDialogCce" Options="@(new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true })">
        <TitleContent>
            <MudText Typo="Typo.h6">Carta de Correção (CC-e)</MudText>
        </TitleContent>
        <DialogContent>
            <MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true">
                <b>Permitido corrigir:</b> CFOP (sem alterar natureza da operação), endereço do destinatário, dados complementares.<br/>
                <b>NÃO permitido:</b> valores fiscais (base de cálculo, alíquota, valor de imposto), CNPJ do destinatário, quantidade, data de emissão.
            </MudAlert>
            <MudTextField @bind-Value="_cceCorrecao" Label="Texto da correção (mín. 15, máx. 1000 caracteres)"
                          Variant="Variant.Outlined" Lines="6" Counter="1000" MaxLength="1000"
                          Immediate="true" />
            <MudText Typo="Typo.caption" Color="Color.Default" Class="mt-2">
                Limite: 20 CC-e por NF-e, dentro de 30 dias após autorização.
            </MudText>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => _mostrarDialogCce = false)">Cancelar</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                       OnClick="EnviarCce" Disabled="@(_enviandoEvento || (_cceCorrecao?.Trim().Length ?? 0) < 15)">
                @if (_enviandoEvento) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                Enviar à SEFAZ
            </MudButton>
        </DialogActions>
    </MudDialog>

    <!-- Dialog Manifestação -->
    <MudDialog @bind-IsVisible="_mostrarDialogManif" Options="@(new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true })">
        <TitleContent>
            <MudText Typo="Typo.h6">Manifestação do Destinatário</MudText>
        </TitleContent>
        <DialogContent>
            <MudSelect @bind-Value="_manifTipo" Label="Tipo de manifestação" Variant="Variant.Outlined">
                <MudSelectItem Value="210200">Confirmação da Operação</MudSelectItem>
                <MudSelectItem Value="210210">Ciência da Operação</MudSelectItem>
                <MudSelectItem Value="210220">Desconhecimento da Operação</MudSelectItem>
                <MudSelectItem Value="210240">Operação Não Realizada</MudSelectItem>
            </MudSelect>
            @if (_manifTipo == 210240)
            {
                <MudTextField @bind-Value="_manifJust" Label="Justificativa (obrigatória, 15-255 chars)"
                              Variant="Variant.Outlined" Lines="3" Counter="255" MaxLength="255" Class="mt-3" />
            }
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => _mostrarDialogManif = false)">Cancelar</MudButton>
            <MudButton Color="Color.Secondary" Variant="Variant.Filled"
                       OnClick="EnviarManifestacao" Disabled="@_enviandoEvento">
                @if (_enviandoEvento) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                Enviar
            </MudButton>
        </DialogActions>
    </MudDialog>

    <!-- Dialog Envio por E-mail -->
    <MudDialog @bind-IsVisible="_mostrarDialogEmail" Options="@(new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true })">
        <TitleContent>
            <MudText Typo="Typo.h6">Enviar NF-e por E-mail</MudText>
        </TitleContent>
        <DialogContent>
            @if (string.IsNullOrEmpty(_nota?.Destinatario.Email))
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    Nenhum e-mail cadastrado para o destinatário — informe um e-mail para enviar.
                </MudAlert>
            }
            <MudTextField @bind-Value="_emailDestino" Label="E-mail do destinatário" Variant="Variant.Outlined"
                          InputType="InputType.Email" Immediate="true" />
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => _mostrarDialogEmail = false)">Cancelar</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                       OnClick="EnviarEmail" Disabled="@(_enviandoEmail || !EmailPareceValido(_emailDestino))">
                @if (_enviandoEmail) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                Enviar
            </MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private NfeSaas.Application.DTOs.NotaFiscalDetalheDto? _nota;
    private List<EventoFiscalResumoDto>? _eventos;
    private bool _loading = true;
    private bool _mostrarDialogCce;
    private bool _mostrarDialogManif;
    private bool _mostrarDialogEmail;
    private bool _enviandoEvento;
    private bool _enviandoEmail;
    private string _cceCorrecao = "";
    private int _manifTipo = 210210; // Ciência por padrão
    private string _manifJust = "";
    private string _emailDestino = "";

    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Dashboard", href: "/"),
        new BreadcrumbItem("Notas", href: "/notas"),
        new BreadcrumbItem("Detalhe", href: null, disabled: true)
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _nota = await NotaService.GetNotaAsync(Id);
            _eventos = await EventoService.ListarPorNotaAsync(Id);
        }
        catch
        {
            Snackbar.Add("Erro ao carregar nota fiscal.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    async Task EnviarCce()
    {
        var texto = _cceCorrecao?.Trim() ?? "";
        if (texto.Length < 15) { Snackbar.Add("Mínimo 15 caracteres.", Severity.Warning); return; }
        _enviandoEvento = true;
        try
        {
            var (evento, erro) = await EventoService.EmitirCceAsync(Id, new EmitirCceDto(texto));
            if (evento != null && erro == null)
            {
                Snackbar.Add($"CC-e #{evento.SequencialCce} aceita. Protocolo: {evento.Protocolo}", Severity.Success);
                _mostrarDialogCce = false;
                _cceCorrecao = "";
                _eventos = await EventoService.ListarPorNotaAsync(Id);
            }
            else
            {
                Snackbar.Add(erro ?? "Erro ao enviar CC-e.", Severity.Error);
            }
        }
        finally { _enviandoEvento = false; }
    }

    async Task EnviarManifestacao()
    {
        if (_manifTipo == 210240 && (_manifJust?.Trim().Length ?? 0) < 15)
        {
            Snackbar.Add("Justificativa obrigatória (mín. 15 chars) para Operação Não Realizada.", Severity.Warning);
            return;
        }
        _enviandoEvento = true;
        try
        {
            var dto = new ManifestarDto(_manifTipo, _manifJust);
            var (evento, erro) = await EventoService.ManifestarAsync(Id, dto);
            if (evento != null && erro == null)
            {
                Snackbar.Add($"Manifestação registrada. Protocolo: {evento.Protocolo}", Severity.Success);
                _mostrarDialogManif = false;
                _manifJust = "";
                _eventos = await EventoService.ListarPorNotaAsync(Id);
            }
            else
            {
                Snackbar.Add(erro ?? "Erro ao manifestar.", Severity.Error);
            }
        }
        finally { _enviandoEvento = false; }
    }

    static string NomeTipoEvento(int tipo) => tipo switch
    {
        110110 => "Carta de Correção",
        110111 => "Cancelamento",
        999000 => "Inutilização",
        210200 => "Manif: Confirmação",
        210210 => "Manif: Ciência",
        210220 => "Manif: Desconhecimento",
        210240 => "Manif: Não Realizada",
        _ => $"Evento {tipo}"
    };

    static string TruncarTexto(string s, int max) =>
        string.IsNullOrEmpty(s) || s.Length <= max ? s : s[..max] + "…";

    void AbrirDialogEmail()
    {
        _emailDestino = _nota?.Destinatario.Email ?? "";
        _mostrarDialogEmail = true;
    }

    static bool EmailPareceValido(string? email) =>
        !string.IsNullOrWhiteSpace(email) && email.Contains('@') && email.Contains('.');

    async Task EnviarEmail()
    {
        _enviandoEmail = true;
        try
        {
            var (sucesso, mensagem) = await NotaService.EnviarEmailAsync(Id, _emailDestino.Trim());
            if (sucesso)
            {
                Snackbar.Add(mensagem ?? "E-mail enviado com sucesso.", mensagem == null ? Severity.Success : Severity.Warning);
                _mostrarDialogEmail = false;
                _nota = await NotaService.GetNotaAsync(Id);
            }
            else
            {
                Snackbar.Add(mensagem ?? "Erro ao enviar e-mail.", Severity.Error);
            }
        }
        finally { _enviandoEmail = false; }
    }

    async Task DownloadDanfe()
    {
        var pdf = await NotaService.GetDanfePdfAsync(Id);
        if (pdf == null)
        {
            Snackbar.Add("Erro ao gerar DANFE.", Severity.Error);
            return;
        }

        var filename = $"DANFE_{_nota!.Numero:D9}.pdf";
        await JS.InvokeVoidAsync("downloadFile", filename, "application/pdf", Convert.ToBase64String(pdf));
        Snackbar.Add("DANFE gerado com sucesso!", Severity.Success);
    }

    Color GetCorSituacao(NfeSaas.Domain.Enums.SituacaoNota s) => s switch
    {
        NfeSaas.Domain.Enums.SituacaoNota.Autorizada => Color.Success,
        NfeSaas.Domain.Enums.SituacaoNota.Cancelada => Color.Error,
        NfeSaas.Domain.Enums.SituacaoNota.Rejeitada => Color.Warning,
        NfeSaas.Domain.Enums.SituacaoNota.Denegada  => Color.Error,
        NfeSaas.Domain.Enums.SituacaoNota.Enviada   => Color.Info,
        _ => Color.Default
    };

    static string NomeSituacao(NfeSaas.Domain.Enums.SituacaoNota s) => s switch
    {
        NfeSaas.Domain.Enums.SituacaoNota.Rascunho  => "Rascunho",
        NfeSaas.Domain.Enums.SituacaoNota.Enviada   => "Enviada",
        NfeSaas.Domain.Enums.SituacaoNota.Autorizada => "Autorizada",
        NfeSaas.Domain.Enums.SituacaoNota.Cancelada => "Cancelada",
        NfeSaas.Domain.Enums.SituacaoNota.Denegada  => "Denegada",
        NfeSaas.Domain.Enums.SituacaoNota.Rejeitada => "Rejeitada",
        _ => s.ToString()
    };
}
